/vendor
/node_modules

# Build output
/src/public/storage
/src/public/build
/src/public/hot

# Environment
.env
.env.backup
.env.production

# Generated runtime state.
#
# These rules used to point at /storage and /public, but this skeleton keeps
# both under src/ — so nothing was actually ignored and compiled Blade views,
# session files, cache data and logs were all committed. That is how a
# compiled view containing a *fatal PHP parse error* ended up in version
# control and kept being served instead of being recompiled.
/src/storage/framework/cache/data/*
!/src/storage/framework/cache/data/.gitignore
/src/storage/framework/sessions/*
!/src/storage/framework/sessions/.gitignore
/src/storage/framework/views/*
!/src/storage/framework/views/.gitignore
/src/storage/logs/*
!/src/storage/logs/.gitignore
/src/storage/app/public/*
!/src/storage/app/public/.gitignore
/src/storage/*.key

# Bootstrap caches are regenerated by config:cache / route:cache / package:discover
/src/bootstrap/cache/*.php
!/src/bootstrap/cache/.gitkeep

# Local development database
/database/*.sqlite
/database/*.sqlite-journal

# Tooling
.phpunit.result.cache
.phpunit.cache
/.idea
/.vscode

# Archives. The repository carried a tracked `tests.zip` — a stale snapshot of
# the whole project including a .env — which shipped to every new project via
# composer create-project.
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
