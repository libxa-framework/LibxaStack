{
    "name": "libxa/libxa",
    "description": "libxaFrame Starter Application \u2014 Build something elite.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "libxa/framework": "^0.8.0 || dev-main@dev",
        "workerman/workerman": "^4.1",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "pestphp/pest": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/app/"
        },
        "classmap": [
            "src/database/migrations"
        ],
        "files": [
            "src/bootstrap/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"is_dir('database') || mkdir('database', 0755, true);\"",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php libxa key:generate --ansi"
        ],
        "serve": "php libxa serve",
        "ws": "php libxa ws:serve",
        "test": "phpunit --no-coverage",
        "lint": "@php tools/lint.php src tests tools",
        "check": [
            "@lint",
            "@test",
            "composer audit --no-interaction"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "Libxa": {
            "modules-path": "src/app/Modules",
            "packages-path": "packages"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "//": "Local sibling checkout of the framework. symlink:true means vendor/libxa/framework IS the working copy at ../libxaframe (a junction on Windows), so edits to the framework are live immediately and can never drift out of sync with a mirrored copy. The url is a glob on purpose: a plain path that does not exist makes Composer abort, which would break composer create-project for anyone without the sibling directory - with no match, resolution falls through to the packagist constraint in require.",
            "type": "path",
            "url": "../libxaframe*",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts-descriptions": {
        "test": "Run the application test suite",
        "lint": "Syntax-check every PHP file",
        "check": "Everything CI runs, locally",
        "serve": "Start the development server"
    },
    "support": {
        "issues": "https://github.com/libxa-framework/LibxaStack/issues",
        "source": "https://github.com/libxa-framework/LibxaStack",
        "security": "https://github.com/libxa-framework/LibxaStack/security/policy"
    },
    "authors": [
        {
            "name": "Voukeng Dongmo Franky Steve",
            "email": "libxa@vyloxi.com",
            "role": "Maintainer"
        }
    ],
    "keywords": [
        "libxa",
        "framework",
        "starter-kit",
        "skeleton",
        "php"
    ],
    "homepage": "https://github.com/libxa-framework/LibxaStack"
}