##################################################
# LibxaFrame — Environment Configuration
##################################################

APP_NAME="LibxaFrame App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

##################################################
# Server
##################################################

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

##################################################
# Database
#
# DB_CONNECTION picks the connection from src/config/database.php.
# Supported: sqlite, mysql, pgsql.
#
# DB_DRIVER is still read as an alias for compatibility with older projects,
# but DB_CONNECTION is the name to use.

DB_CONNECTION=sqlite

# SQLite -----------------------------------------------------------------
# Relative paths resolve against src/database/. Use :memory: for tests.
DB_SQLITE_PATH=database.sqlite

# MySQL / MariaDB --------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=libxa
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL -------------------------------------------------------------
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=libxa
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SCHEMA=public
# DB_SSLMODE=prefer

TENANCY_STRATEGY=separate_database
TENANCY_RESOLVER=subdomain

##################################################
# Security
##################################################

CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60

##################################################
# AI Management (optional)
##################################################

ATLAS_AI_ENABLED=false
ATLAS_AI_PROVIDER=openai
ATLAS_AI_KEY=your-api-key
ATLAS_AI_MODEL=gpt-4o-mini
ATLAS_AI_READ_ONLY=true
ATLAS_QUERY_LOG=false

OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
